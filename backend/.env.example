# MongoDB connection string (mongodb+srv://... o mongodb://localhost:27017/expenses)
MONGODB_URI=

# Server
PORT=3001
NODE_ENV=development

# CORS - frontend origin(s), coma-separado (en dev aceptamos cualquier localhost:*)
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=cambiar_por_algo_random_largo
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Admins (coma-separado). Pueden archivar categorías predefinidas.
ADMIN_EMAILS=
